[tool:pytest]
# Pytest configuration for utilities package

testpaths = tests
python_files = test_*.py *_test.py
python_classes = Test*
python_functions = test_*

# Test discovery patterns
addopts = 
    --verbose
    --tb=short
    --strict-markers
    --disable-warnings
    --cov=.
    --cov-report=term-missing
    --cov-report=html:htmlcov

# Minimum version
minversion = 6.0

# Markers for test categorization
markers =
    unit: Unit tests
    integration: Integration tests
    slow: Slow running tests
    hdfs: Tests requiring HDFS
    spark: Tests requiring PySpark
    geopy: Tests requiring geopy
    network: Tests requiring network access

# Test timeout
timeout = 300

# Ignore patterns
norecursedirs = 
    .git
    .tox
    dist
    build
    *.egg
    __pycache__
    .cache

# Coverage settings
cov_fail_under = 80
